# DB++ phát hiện vùng chữ, mã container NGANG. Vốn đã dynamic shape. FP32: FP16 làm bitmap
# xác suất lệch tới 0,198 trong khi ngưỡng quyết định là 0,1-0,2 — đủ để lật một hộp. Xem
# DN-013. Bản *_folded: input là **UINT8 NHWC**, pixel BGR THÔ. Chuẩn hoá đã gấp vào đồ
# thị. Sinh bằng tools/fold_preprocess.py. Xem DN-011, DN-012.
#
# SINH TỰ ĐỘNG bởi tools/export_models.py — đừng sửa tay.

name: "craneops_ccode_det_h"
platform: "tensorrt_plan"
max_batch_size: 8

input [
  {
    name: "x"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]

output [
  {
    name: "sigmoid_10.tmp_0"
    data_type: TYPE_FP32
    dims: [ 1, -1, -1 ]
  }
]

# Chạy một cú giả lúc nạp: cú đầu tiên đắt gấp 3-6 lần (xem _warmup_block).
model_warmup [
  {
    name: "khoi_dong"
    batch_size: 1
    inputs {
      key: "x"
      value {
        data_type: TYPE_UINT8
        dims: [ 640, 672, 3 ]
        zero_data: true
      }
    }
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

version_policy: { specific: { versions: [ 1 ] } }
