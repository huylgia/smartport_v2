# Mã container NGANG: det -> hậu xử lý -> nắn phối cảnh -> cổng nét -> rec -> giải mã CTC.
# Chạy Python backend theo kiểu BLS, KHÔNG phải ensemble: cổng nét loại bớt crop nên
# số tensor ra khác số tensor vào, đồ thị tĩnh không diễn đạt được. Xem DN-007.
#
# SINH TỰ ĐỘNG bởi tools/export_models.py — đừng sửa tay.

name: "craneops_ccode_h"
backend: "python"

# 0 = không gom batch ở tầng này. Ảnh ROI mỗi camera một kích thước nên không xếp
# chồng được; việc gom batch xảy ra ở tầng dưới, trên các crop đã cùng 64x256.
max_batch_size: 0

input [
  {
    name: "image"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  },
  {
    name: "params"
    data_type: TYPE_STRING
    dims: [ 1 ]
    optional: true
  }
]

output [
  {
    name: "texts"
    data_type: TYPE_STRING
    dims: [ -1 ]
  },
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "boxes"
    data_type: TYPE_INT32
    dims: [ -1, 4 ]
  },
  {
    name: "quads"
    data_type: TYPE_INT32
    dims: [ -1, 4, 2 ]
  },
  {
    name: "det_scores"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "sharpness"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]

parameters {
  key: "det_model"
  value: { string_value: "craneops_ccode_det_h" }
}
parameters {
  key: "det_output"
  value: { string_value: "sigmoid_10.tmp_0" }
}
parameters {
  key: "rec_model"
  value: { string_value: "craneops_ccode_rec_h" }
}
parameters {
  key: "rec_output"
  value: { string_value: "save_infer_model/scale_0.tmp_0" }
}
parameters {
  key: "vertical"
  value: { string_value: "false" }
}

# 3 tiến trình Python thật (không phải luồng) — hậu xử lý DB nặng
# CPU và bị GIL chặn. Đây là tham số quyết định throughput của cả nhánh: đo được
# 230 req/s với count=1 so với 610 với count=3. Xem HARDWARE_BUDGET §6.1.
instance_group [
  {
    count: 3
    kind: KIND_CPU
  }
]

version_policy: { specific: { versions: [ 1 ] } }
