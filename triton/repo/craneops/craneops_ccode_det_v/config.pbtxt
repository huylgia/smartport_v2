# DB phát hiện vùng chữ, mã container DỌC. FP32 (xem DN-013). Bản *_folded: input là
# **UINT8 NHWC**, pixel BGR THÔ, chuẩn hoá đã gấp vào đồ thị.
#
# SINH TỰ ĐỘNG bởi tools/export_models.py — đừng sửa tay.

name: "craneops_ccode_det_v"
platform: "tensorrt_plan"
max_batch_size: 8

input [
  {
    name: "x"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]

output [
  {
    name: "save_infer_model/scale_0.tmp_1"
    data_type: TYPE_FP32
    dims: [ 1, -1, -1 ]
  }
]

# Chạy một cú giả lúc nạp: cú đầu tiên đắt gấp 3-6 lần (xem _warmup_block).
model_warmup [
  {
    name: "khoi_dong"
    batch_size: 1
    inputs {
      key: "x"
      value {
        data_type: TYPE_UINT8
        dims: [ 512, 576, 3 ]
        zero_data: true
      }
    }
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

version_policy: { specific: { versions: [ 1 ] } }
