# Biến môi trường cho stack Triton (build/docker-compose.triton.yml).
# Sao chép thành .env.triton rồi điền. KHÔNG commit .env.triton.
#
#   cp build/.env.triton.example build/.env.triton
#
# Chạy:
#   docker compose --env-file build/.env.triton -f build/docker-compose.triton.yml up -d

# Giấy phép có chữ ký Ed25519, dạng CO2.<payload>.<chữ ký>.
#
# Quy trình cấp — khoá riêng KHÔNG BAO GIỜ rời khỏi bên cấp phép:
#
#   1. bên cấp phép, một lần duy nhất:
#        python -m tools.issue_license --new-keypair --out-private ~/craneops-license.key
#      rồi dán EMBEDDED_PUBLIC_KEY vào internal/pkg/license.py
#
#   2. TRÊN MÁY ĐÍCH, trong ĐÚNG container sẽ chạy — lấy vân tay:
#        docker compose --env-file build/.env.triton -f build/docker-compose.triton.yml \
#          run --rm modelsvc python3 -m tools.issue_license --fingerprint
#
#   3. bên cấp phép ký cho digest nhận được:
#        python -m tools.issue_license --issue <digest> --note GC03 --days 365
#
# ⚠️ Vân tay gồm UUID của GPU, nên CRANEOPS_GPU bên dưới phải giống lúc lấy vân tay.
CRANEOPS_LICENSE_KEY=

# Mật khẩu giải mã model .t7. Đọc từ đây, không bao giờ nhúng vào source — `strings`
# trên binary PyInstaller là moi ra được.
CRANEOPS_MODEL_PASSWORD=

# Kho model đã mã hoá (.t7) và ảnh mẫu có nhãn.
CRANEOPS_ASSETS=/ssd1/huylg/dnp_project/smartport/assets

# Image. Build: docker build -t craneops-triton:dev -f build/triton.Dockerfile .
TRITON_IMAGE=craneops-triton:dev

# --- giới hạn tài nguyên (máy dùng chung) -------------------------------------
# GPU nào được cấp cho container. PHẢI trùng với lúc lấy vân tay cấp phép.
CRANEOPS_GPU=0

MODELSVC_CPUS=4
MODELSVC_MEMORY=12g
TRITON_CPUS=8
TRITON_MEMORY=8g

# VRAM: Docker không giới hạn cứng được, nên chặn ở tầng Triton.
# 2 GiB pool + 256 MiB pinned. Ngân sách đầy đủ: docs/HARDWARE_BUDGET.md §3.
TRITON_CUDA_POOL=2147483648
TRITON_PINNED_POOL=268435456

# Cổng công bố ra host. Mặc định 18000-18002 vì 8000-8002 thường đã bị chiếm.
TRITON_HTTP_PORT=18000
TRITON_GRPC_PORT=18001
TRITON_METRICS_PORT=18002
