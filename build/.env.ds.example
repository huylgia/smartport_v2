# Biến môi trường cho ds_app (build/docker-compose.ds.yml).
# Sao chép thành .env.ds rồi điền. KHÔNG commit .env.ds.
#
#   cp build/.env.ds.example build/.env.ds
#
# Vì sao tách khỏi .env.triton: hai service có ngân sách tài nguyên, tập secret và vòng
# đời khác hẳn nhau. Gộp chung thì đổi một biến của Triton lại phải khởi động lại ds_app.

# --- camera RTSP (SECRET: URL có credential) -----------------------------------
# Khớp với ${CAM01_RTSP} … trong configs/cranes/GC03.yaml.
# Thiếu một biến ⇒ load config báo rõ thiếu biến nào, không chạy nửa vời.
#
# CHỈ là URL — không kèm codec, không kèm fps:
#   * codec tự nhận (nvurisrcbin dò, nhánh ghi lấy đúng họ parser mà nhánh decode dùng)
#   * fps lấy nguyên của nguồn; giảm nhịp ở decoder KHÔNG tiết kiệm NVDEC (HARDWARE_BUDGET §2.2)
#
# Mã camera suy từ URL: <mã cẩu>_<ip>_<cổng>, ví dụ GC03_113_160_225_15_1508.
# 10 camera GC03 chung một IP nên CỔNG là thứ phân biệt chúng; mã trùng bị từ chối lúc load.
CAM01_RTSP=
CAM02_RTSP=
CAM03_RTSP=
CAM04_RTSP=
CAM05_RTSP=
CAM06_RTSP=
CAM07_RTSP=
CAM08_RTSP=
CAM09_RTSP=
CAM10_RTSP=

# --- ghi hình ------------------------------------------------------------------
# Thư mục trên HOST chứa segment. Ở cảng trỏ vào ổ dành riêng cho video.
# Tương đối thì tính từ build/, không phải gốc repo.
CRANEOPS_REC_DIR=../.rec
# Độ dài mỗi đoạn (giây). Đây là GIỚI HẠN, không phải độ dài thật: splitmuxsink chỉ cắt tại
# keyframe nên độ dài thật là bội số của GOP nguồn (~1,7 s).
#
# Đánh đổi: đoạn dài ⇒ ít file hơn, nhưng đoạn ĐANG MỞ kéo dài hơn, mà `evidenced` phải chờ
# một đoạn đóng mới cắt được từ nó. Độ dài đoạn CHÍNH LÀ độ trễ tệ nhất của bằng chứng.
SEGMENT_SEC=10

# Giữ segment bao lâu (giây). 1800 = 30 phút, cửa sổ triage. Xem HARDWARE_BUDGET §2.6.
# Phải lớn hơn SEGMENT_SEC nhiều lần, nếu không sweeper xoá gần như ngay sau khi ghi.
RETAIN_SEC=1800

# --- giới hạn tài nguyên (máy dùng chung) ---------------------------------------
# ⚠️ KHÔNG có biến chọn GPU ở đây. NVDEC đòi `count: all` trong compose; pin bằng
# device_ids làm nvv4l2decoder treo ở PREROLLING không báo lỗi (DN-014). Cần chia GPU
# thì đặt NVIDIA_VISIBLE_DEVICES.
DS_CPUS=6
DS_MEMORY=6g

DS_IMAGE=craneops-ds:dev

# --- gỡ lỗi ---------------------------------------------------------------------
# 1 = chỉ lỗi. 3+ rất ồn nhưng cần khi truy negotiate caps.
GST_DEBUG=1
