{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRANE01 — config theo camera_code",
  "description": "Sinh từ internal/rules/configs.py — đừng sửa tay. Khoá là camera_code (xem configs/cranes/*.yaml); mỗi camera một dòng.",
  "type": "object",
  "additionalProperties": {
    "additionalProperties": false,
    "description": "``CRANE01`` — gán lane từ bbox đầu kéo trên camera nhìn xuống.",
    "properties": {
      "lane1_zone": {
        "description": "Đa giác của làn 1 trên khung hình CAMERA NÀY, toạ độ tương đối [0..1]. Để trống\nnghĩa là camera này không nhìn thấy làn 1.",
        "items": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "type": "array"
        },
        "title": "Lane1 Zone",
        "type": "array"
      },
      "lane2_zone": {
        "description": "Như :attr:`lane1_zone`, cho làn 2.",
        "items": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "type": "array"
        },
        "title": "Lane2 Zone",
        "type": "array"
      },
      "lane3_zone": {
        "description": "Như :attr:`lane1_zone`, cho làn 3.",
        "items": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "type": "array"
        },
        "title": "Lane3 Zone",
        "type": "array"
      },
      "lane_anchor": {
        "default": 1,
        "description": "Điểm mốc của bbox dùng để xét nằm trong vùng nào.",
        "examples": [
          "CENTER",
          "BOTTOM",
          "CENTER|BOTTOM"
        ],
        "type": "string"
      },
      "head_thresh": {
        "default": 0.6,
        "description": "Ngưỡng tin cậy tối thiểu cho bbox đầu kéo.",
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Head Thresh",
        "type": "number"
      }
    },
    "title": "Crane01Config",
    "type": "object"
  }
}
